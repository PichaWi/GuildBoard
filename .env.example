# ==============================================================================
# GuildBoard Environment Configuration
# Copy this file to .env before starting containers: `cp .env.example .env`
# NEVER commit the actual .env file or bake secrets into Docker images.
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
APP_NAME=GuildBoard
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# For local Docker Compose, defaults connect to the internal 'db' service:
DATABASE_URL=postgresql://postgres:postgres@db:5432/guildboard
# Running uvicorn / alembic on your own machine (database from `docker compose up -d db`)?
# Use localhost instead of db:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guildboard

# PostgreSQL container credentials (used by the 'db' service in docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guildboard

# Docker's backend container ignores DATABASE_URL and uses the 'db' service.
# To point the container somewhere else, set DOCKER_DATABASE_URL instead.

# For Supabase / Managed PostgreSQL, replace DATABASE_URL with your connection string:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Frontend & Mock Configuration
# ------------------------------------------------------------------------------
# Set to 'true' to use client-side mock data; 'false' for live API integration.
VITE_USE_MOCK=false

# Where the browser returns after Google sign-in:
# - For Docker Compose (Nginx frontend): http://localhost:3000
# - For local Vite development server:   http://localhost:5173
FRONTEND_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Security & Sessions
# ------------------------------------------------------------------------------
# Signed session secret. Must be AT LEAST 32 characters long.
# Do not use public placeholders (e.g., 'change-me', 'replace-with').
SESSION_SECRET=guildboard_super_secret_session_key_minimum_32_chars_long

# ------------------------------------------------------------------------------
# Google OAuth2 Sign-In (SRS-11, SRS-12)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
ALLOWED_EMAIL_DOMAIN=ku.th

# ------------------------------------------------------------------------------
# Optional Local / QA Mock Dev Login
# ------------------------------------------------------------------------------
# Keep disabled in production. Allows quick testing without Google OAuth.
DEV_LOGIN_ENABLED=true
DEMO_STUDENT_EMAIL=student.demo@ku.th
DEMO_STUDENT_PASSWORD=demo_student_password_123
DEMO_LECTURER_EMAIL=lecturer.demo@ku.th
DEMO_LECTURER_PASSWORD=demo_lecturer_password_123

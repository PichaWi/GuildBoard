# Supabase / PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
PORT=8000
ENVIRONMENT=production

# Signed session cookie. Generate a long random value for every deployment.
SESSION_SECRET=

# Optional local/QA login. Keep disabled in production; credentials are server-side only.
DEV_LOGIN_ENABLED=false
DEMO_STUDENT_EMAIL=student.demo@ku.th
DEMO_STUDENT_PASSWORD=replace-with-a-local-only-password
DEMO_LECTURER_EMAIL=lecturer.demo@ku.th
DEMO_LECTURER_PASSWORD=replace-with-a-local-only-password

# Google OAuth2 sign-in. Create an OAuth client ID under Google Cloud
# Console > APIs & Services > Credentials, and register the redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Only accounts in this domain may sign in.
ALLOWED_EMAIL_DOMAIN=ku.th
